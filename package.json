{
  "name": "eyas",
  "version": "0.8.20-beta",
  "type": "module",
  "private": true,
  "license": "MIT",
  "author": "eYssen",
  "bin": {
    "eyas": "./bin/eyas"
  },
  "scripts": {
    "dev": "bun --hot src/main.ts",
    "dev:watch": "bun --watch src/main.ts",
    "dev:web": "cd src/web && bunx vite",
    "build": "bun build src/main.ts --outdir dist --target bun",
    "build:web": "cd src/web && bunx vite build",
    "docs:dev": "cd packages/docs && bun run dev",
    "docs:build": "cd packages/docs && bun run build",
    "docs:preview": "cd packages/docs && bun run preview",
    "test": "bun vitest run",
    "test:watch": "bun vitest",
    "test:e2e": "bun vitest run --config vitest.e2e.config.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.2.89",
    "@anthropic-ai/sdk": "^0.91.1",
    "@casl/ability": "^6.8.0",
    "@google/genai": "^1.47.0",
    "@mozilla/readability": "^0.6.0",
    "@orama/orama": "^3.1.18",
    "argon2": "^0.44.0",
    "basic-ftp": "^6.2.0",
    "better-sqlite3": "^12.8.0",
    "chokidar": "^5.0.0",
    "citty": "^0.2.2",
    "croner": "^10.0.1",
    "diff": "^8.0.2",
    "dompurify": "^3.4.14",
    "drizzle-orm": "^0.45.2",
    "exceljs": "^4.4.0",
    "fast-json-patch": "^3.1.1",
    "file-type": "^22.0.0",
    "grammy": "^1.42.0",
    "gray-matter": "^4.0.3",
    "hono": "^4.7.0",
    "i18next": "^25.0.0",
    "jose": "^6.2.2",
    "jsdom": "^29.0.1",
    "mammoth": "^1.12.0",
    "mime-types": "^3.0.2",
    "nanoid": "^5.1.7",
    "nodemailer": "^9.0.1",
    "openai": "^6.33.0",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^2.4.5",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "playwright-core": "^1.62.1",
    "react-is": "^19.2.4",
    "recharts": "^3.8.1",
    "remark-parse": "^11.0.0",
    "remark-stringify": "^11.0.0",
    "s3mini": "^0.9.2",
    "sqlite-vec": "^0.1.9",
    "ssh2": "^1.17.0",
    "tree-sitter-wasms": "0.1.13",
    "turndown": "^7.2.2",
    "undici": "^7.24.7",
    "unified": "^11.0.5",
    "web-tree-sitter": "0.24.4",
    "yaml": "^2.7.0",
    "zod": "3.24.4",
    "zod-to-json-schema": "3.22.5"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.6",
    "@types/better-sqlite3": "^7.6.13",
    "@types/bun": "^1.2.0",
    "@types/diff": "^8.0.0",
    "@types/jsdom": "^28.0.1",
    "@types/mime-types": "^3.0.1",
    "@types/nodemailer": "^8.0.0",
    "@types/react-is": "^19.2.0",
    "@types/ssh2": "^1.15.5",
    "@types/turndown": "^5.0.6",
    "drizzle-kit": "^0.31.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "typescript": "^5.9.0",
    "vitest": "^3.1.0"
  }
